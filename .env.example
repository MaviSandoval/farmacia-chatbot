# Copiá este archivo como .env y completá tus valores. El .env nunca se sube a GitHub.

# Groq (https://console.groq.com)
GROQ_API_KEY=tu_clave_de_groq

# WhatsApp Cloud API (developers.facebook.com > tu app > WhatsApp > Configuración de la API)
WHATSAPP_TOKEN=token_de_acceso_de_meta
WHATSAPP_PHONE_NUMBER_ID=id_del_numero_de_prueba
WHATSAPP_VERIFY_TOKEN=un_texto_que_inventes_vos
WHATSAPP_APP_SECRET=clave_secreta_de_la_app

# WhatsApp por Twilio, alternativa a Meta (console.twilio.com > Account Info)
TWILIO_AUTH_TOKEN=auth_token_de_twilio

# Telegram (hablale a @BotFather en Telegram y usá /newbot)
TELEGRAM_TOKEN=token_que_da_botfather
TELEGRAM_SECRET=otro_texto_que_inventes_vos
